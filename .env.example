OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# Optional, practice chat voice: natural voices and transcription for browsers without speech recognition
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# People search (free tier: $10 of credits each month, no card). Get a key at https://dashboard.exa.ai/api-keys
EXA_API_KEY=your-exa-key-here
PORT=3000

# Accounts and saved chats (required). Supabase -> Project Settings -> API.
# Use the publishable/anon key, never the secret/service_role key. Run supabase/schema.sql once and turn off "Confirm email".
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-key

# Optional: other site addresses allowed to submit forms to this server (comma-separated), e.g. your deployed URL.
# A GitHub Codespace's forwarded address is allowed automatically.
APP_ORIGIN=
