OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# People search (free tier: $10 of credits each month, no card). Get a key at https://dashboard.exa.ai/api-keys
EXA_API_KEY=your-exa-key-here
PORT=3000

# Optional, Work and projects (each person's public work). Free keys that only raise rate limits:
# GITHUB_TOKEN=          a GitHub token with no scopes (github.com/settings/tokens): 5,000 calls an hour instead of 60
# OPENALEX_API_KEY=      openalex.org/settings/api: its own daily budget instead of one shared per IP
# STACKEXCHANGE_KEY=     stackapps.com (register an app): 10,000 Stack Overflow calls a day instead of 300
# WORK_LOOKUPS_PER_DAY=60

# Accounts and saved chats (required). Supabase -> Project Settings -> API.
# Use the publishable/anon key, never the secret/service_role key. Run supabase/schema.sql once and turn off "Confirm email".
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-key

# Optional: other site addresses allowed to submit forms to this server (comma-separated), e.g. your deployed URL.
# A GitHub Codespace's forwarded address is allowed automatically.
APP_ORIGIN=
